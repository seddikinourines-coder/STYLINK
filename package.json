{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');['package-lock.json','yarn.lock'].forEach(f=>fs.existsSync(f)&&fs.unlinkSync(f));const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "catalogs": {
      "default": {
        "@replit/vite-plugin-cartographer": "^0.5.1",
        "@replit/vite-plugin-dev-banner": "^0.1.1",
        "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
        "@tailwindcss/vite": "^4.1.14",
        "@tanstack/react-query": "^5.90.21",
        "@types/node": "^25.3.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "framer-motion": "^12.23.24",
        "lucide-react": "^0.545.0",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "vite": "^7.3.2",
        "zod": "^3.25.76"
      }
    },
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
